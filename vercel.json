{
  "framework": "nextjs",
  "headers": [
    {
      "source": "/twww/creatives/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/twww/(.*)\\.(webp|png|jpg|jpeg|gif|svg|mp4|webm|woff2?)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
